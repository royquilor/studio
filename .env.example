# Copy to .env.local and fill in locally.
# Never put real keys in this file or commit .env.local.

# NEXT_PUBLIC_ values are sent to the browser. Keep secrets unprefixed.

# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk (add only when auth is installed)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Convex (add only when the database is installed)
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=

# Polar (add only when payments are installed)
# POLAR_ACCESS_TOKEN=
# POLAR_WEBHOOK_SECRET=

# Resend (add only when email is installed)
# RESEND_API_KEY=

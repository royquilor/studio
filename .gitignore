# See https://help.github.com/articles/ignoring-files/

# --- dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- next.js / build ---
.next/
out/
build/
dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- testing ---
coverage/
.nyc_output/

# --- env and secrets (never commit real values) ---
.env
.env.*
!.env.example
!.env*.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
id_rsa
id_rsa.*
credentials.json
**/secrets/
*.secret
*.secrets

# Clerk / Convex / Polar / Vercel local auth
.clerk/
.convex/
.vercel/

# MCP and editor auth (tokens often live here)
.cursor/mcp.json
.mcp.json
.claude/settings.local.json

# --- logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
*~
